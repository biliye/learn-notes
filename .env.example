# ============================================================
# learn-notes 环境变量模板 —— 复制为 .env 后填写真实值
# 复制后：cp .env.example .env，然后修改密码/secret
# 绝不把 .env 提交进 git
# ============================================================

# --- MySQL（compose 内建容器用）---
MYSQL_ROOT_PASSWORD=change-me-root-password
MYSQL_DATABASE=learn_notes

# --- 后端数据库连接（Docker 内指向 ln-mysql；本地开发指向本机 MySQL）---
APP_DB_URL=jdbc:mysql://ln-mysql:3306/learn_notes?useUnicode=true&characterEncoding=utf8&serverTimezone=Asia/Shanghai&allowPublicKeyRetrieval=true&useSSL=false
APP_DB_USERNAME=root
APP_DB_PASSWORD=change-me-root-password

# --- JWT ---
# 至少 32 字符随机串；更换会导致旧 token 全部失效
APP_JWT_SECRET=change-me-to-a-long-random-string-at-least-32-chars
APP_JWT_EXPIRE_MINUTES=720

# --- 管理员初始账号（首次启动自动创建；已存在则忽略）---
APP_ADMIN_USERNAME=admin
APP_ADMIN_PASSWORD=change-me-admin-password

# --- agent 导入专用 API Token（至少 16 字符）---
APP_API_TOKEN=change-me-api-token

# --- 存储目录（容器内路径）---
APP_STORAGE_DIR=/app/storage/docs
APP_UPLOAD_DIR=/app/storage/uploads
APP_MAX_IMAGE_MB=5

# --- 对外访问端口（默认 8088，不抢 80；见设计规格 D13）---
WEB_PORT=8088
